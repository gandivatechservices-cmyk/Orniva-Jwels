{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "baseUrl": "src",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"],
      "components": ["components/index"],
      "components/*": ["components/*"],
      "constants": ["constants/index"],
      "constants/*": ["constants/*"],
      "hooks": ["hooks/index"],
      "hooks/*": ["hooks/*"],
      "guards": ["guards/index"],
      "guards/*": ["guards/*"],
      "store": ["store/index"],
      "store/*": ["store/*"],
      "utility": ["utility/index"],
      "utility/*": ["utility/*"],
      "utility/services": ["utility/services/index"],
      "utility/services/*": ["utility/services/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": ["node_modules"]
}
